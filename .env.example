# ── AI API Keys (可选 — 也可在应用设置页面 UI 中配置) ──
# OpenAI / 兼容接口
OPENAI_API_KEY=sk-xxx
# 自定义 API Base URL (默认 https://api.openai.com/v1)
# OPENAI_API_BASE=https://api.openai.com/v1

# 通义千问
# QWEN_API_KEY=sk-xxx

# 腾讯混元
# HUNYUAN_API_KEY=xxx

# ── 数据库 (可选 — 仅 server functions 使用，前端页面不依赖) ──
# DATABASE_URL=postgresql://postgres:password@localhost:5432/myapp
